{
  "name": "@bwanamaker/brandobot",
  "version": "0.2.1",
  "description": "An OpenCode plugin that controls browsers through Playwright CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwanamaker/brandobot.git"
  },
  "bugs": "https://github.com/bwanamaker/brandobot/issues",
  "homepage": "https://github.com/bwanamaker/brandobot#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "playwright",
    "browser-automation"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.25",
    "@playwright/cli": "^0.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.9",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
