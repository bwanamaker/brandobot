{
  "name": "brandobot",
  "version": "0.1.0",
  "description": "An OpenCode plugin that controls browsers through Playwright CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "plugin",
    "playwright",
    "browser-automation"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.25",
    "@playwright/cli": "^0.1.18"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
